<style>
:root{
  /* 夜晚（默认）：取自产品 BJJ Sequence */
  --bg:#110e17; --bg2:#16121d; --panel:#1a1622; --panel2:#221d2c; --line:#2c2637; --line2:#3a3348;
  --ink:#ece9f1; --sub:#c3bdd0; --muted:#a29cb0; --dim:#8b849e;
  --acc:#c4b5fd; --acc-soft:rgba(196,181,253,.13); --acc-line:rgba(196,181,253,.42); --on-acc:#18122a;
  --blue:#5b9cf0; --blue-soft:rgba(91,156,240,.13); --blue-line:rgba(91,156,240,.42);
  --green:#4fb783; --green-soft:rgba(79,183,131,.14);
  --glass:rgba(17,14,23,.86); --dotc:rgba(236,233,241,.045); --shadow:var(--shadow); --pub-node:#1d2a26;
  --mono:'JetBrains Mono','DejaVu Sans Mono',ui-monospace,monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Noto Sans SC","Noto Sans CJK SC",system-ui,sans-serif;
  --serif:var(--sans);
  --r:16px; color-scheme:dark;
}
:root[saved-theme="light"]{
  --bg:#faf9f5; --bg2:#f6f3ec; --panel:#ffffff; --panel2:#f3f0e8; --line:#e6e2d8; --line2:#d8d2c4;
  --ink:#1f1e1d; --sub:#57534b; --muted:#66625a; --dim:#8a857a;
  --acc:#5b3fb0; --acc-soft:rgba(91,63,176,.09); --acc-line:rgba(91,63,176,.35); --on-acc:#ffffff;
  --blue:#2f6fca; --blue-soft:rgba(47,111,202,.09); --blue-line:rgba(47,111,202,.35);
  --green:#1f7a4d; --green-soft:rgba(31,122,77,.10);
  --glass:rgba(250,249,245,.88); --dotc:rgba(31,30,29,.05); --shadow:rgba(31,30,29,.08); --pub-node:#e7f3ec;
  color-scheme:light;
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg);color:var(--ink)}
body{font-family:var(--sans);line-height:1.65;-webkit-font-smoothing:antialiased;
  background-image:radial-gradient(circle at 1px 1px,var(--dotc) 1px,transparent 0);background-size:22px 22px}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
.app{display:grid;grid-template-columns:268px 1fr;min-height:100vh}

/* ---------- 侧栏 ---------- */
.side{position:sticky;top:0;height:100vh;overflow:auto;border-right:1px solid var(--line);background:var(--glass);backdrop-filter:blur(6px);padding:26px 18px 20px;display:flex;flex-direction:column}
.brand{display:flex;align-items:center;gap:12px;padding:0 8px}
.logo{width:38px;height:38px;border-radius:11px;background:var(--acc);display:grid;place-items:center;font-family:var(--mono);font-weight:800;color:var(--on-acc);font-size:15px;box-shadow:0 0 24px var(--acc-soft)}
.brand b{font-size:19px;letter-spacing:-.3px} .brand b span{color:var(--muted);font-weight:400}
.tag{padding:0 8px;margin:6px 0 22px;font-size:12.5px;color:var(--muted)}
.grp{font-family:var(--mono);font-size:11px;letter-spacing:1px;color:var(--dim);margin:16px 8px 8px}
.nav{display:flex;align-items:center;gap:10px;width:100%;padding:8px 10px;border-radius:10px;font-size:13.5px;color:var(--sub);text-align:left;transition:.15s}
.nav:hover{background:var(--panel2);color:var(--ink)}
.nav .no{font-family:var(--mono);font-size:11px;width:26px;height:22px;border-radius:6px;border:1px solid var(--line2);display:grid;place-items:center;color:var(--muted);flex:none}
.nav .dot{margin-left:auto;width:7px;height:7px;border-radius:50%;background:var(--line2);flex:none}
.nav.pub .dot{background:var(--green);box-shadow:0 0 8px var(--green)}
.nav.on{background:var(--acc-soft);color:var(--ink)}
.nav.on .no{background:var(--acc);border-color:var(--acc);color:var(--on-acc);font-weight:700}
.nav.off{opacity:.35}
.side .bottom{margin-top:auto;padding:16px 8px 0;border-top:1px solid var(--line);font-size:12px;color:var(--dim);line-height:1.7}

/* ---------- 主区 ---------- */
.main{min-width:0}
.top{position:sticky;top:0;z-index:5;display:flex;align-items:center;gap:14px;padding:14px 40px;border-bottom:1px solid var(--line);background:var(--glass);backdrop-filter:blur(8px);font-size:13px;color:var(--muted)}
.top .crumb b{color:var(--ink);font-weight:500}
.top .sp{flex:1}
.theme-toggle{width:34px;height:34px;border-radius:50%;border:1px solid var(--line2);color:var(--sub);font-size:15px;display:grid;place-items:center;flex:none;transition:.15s}
.theme-toggle:hover{color:var(--ink);border-color:var(--muted)}
.mtop{display:none}
.pill{font-family:var(--mono);font-size:11.5px;border:1px solid var(--line2);border-radius:999px;padding:4px 11px;color:var(--sub)}
.pill.warn{border-color:var(--acc-line);color:var(--acc)}
.wrap{max-width:1040px;margin:0 auto;padding:44px 40px 70px}

.kick{font-family:var(--mono);font-size:12px;letter-spacing:2.5px;color:var(--acc)}
h1{font-family:var(--sans);font-size:50px;line-height:1.18;font-weight:800;letter-spacing:-.5px;margin:14px 0 16px}
h1 em{font-style:normal;color:var(--acc)}
.lede{color:var(--sub);font-size:16px;max-width:720px}
.chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.chip{font-size:12px;border:1px solid var(--line2);border-radius:8px;padding:3px 10px;color:var(--sub)}

/* 统计 */
.stats{display:grid;grid-template-columns:repeat(5,1fr);margin:32px 0 0;border:1px solid var(--line);border-radius:var(--r);background:var(--panel);overflow:hidden}
.stat{padding:16px 18px;border-right:1px solid var(--line)} .stat:last-child{border:none}
.stat b{display:block;font-family:var(--mono);font-size:26px;color:var(--ink);font-weight:700;line-height:1.2}
.stat b i{font-style:normal;color:var(--acc)}
.stat span{font-size:12px;color:var(--muted)}

/* 实验面板 */
.lab{margin-top:36px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(180deg,var(--panel),var(--bg2));overflow:hidden;box-shadow:0 20px 60px var(--shadow)}
.lab-h{display:flex;align-items:center;gap:12px;padding:16px 22px;border-bottom:1px solid var(--line)}
.lab-h .ic{width:30px;height:30px;border-radius:9px;background:var(--acc-soft);color:var(--acc);display:grid;place-items:center;font-family:var(--mono);font-size:13px}
.lab-h b{font-size:14.5px}
.lab-h .sp{flex:1}
.seg{display:flex;border:1px solid var(--line2);border-radius:10px;overflow:hidden}
.seg button{font-size:12.5px;padding:6px 13px;color:var(--muted);transition:.15s}
.seg button.on{background:var(--ink);color:var(--bg);font-weight:700}
.lab-b{padding:22px 22px 8px}
.hint{font-size:12.5px;color:var(--muted);margin-bottom:6px}
.hint kbd{font-family:var(--mono);font-size:11px;border:1px solid var(--line2);border-bottom-width:2px;border-radius:5px;padding:0 5px;color:var(--sub)}
svg.map{width:100%;height:auto;display:block}
.trk{fill:none;stroke:var(--line2);stroke-width:3}
.trk-flow{fill:none;stroke:url(#g);stroke-width:3;stroke-dasharray:6 14;animation:flow 1.6s linear infinite;opacity:.8}
@keyframes flow{to{stroke-dashoffset:-40}}
.band{font-family:var(--mono);font-size:11px;fill:var(--dim);letter-spacing:1px}
.bandn{font-family:var(--sans);font-size:14px;font-weight:700;fill:var(--sub)}
.node{cursor:pointer;outline:none}
.node .halo{fill:var(--acc);opacity:0;transition:.2s}
.node .c{fill:var(--panel);stroke:var(--line2);stroke-width:2;transition:.2s}
.node.S .c{stroke:var(--acc)} .node.A .c{stroke:var(--blue)}
.node text{font-family:var(--mono);font-size:15px;font-weight:700;fill:var(--sub);text-anchor:middle;dominant-baseline:central;pointer-events:none}
.node.pub .c{fill:var(--pub-node)}
.node .pd{fill:var(--green);opacity:0}
.node.pub .pd{opacity:1}
.node:hover .c,.node:focus-visible .c{stroke-width:3}
.node.on .halo{opacity:.18}
.node.on .c{fill:var(--acc);stroke:var(--acc)}
.node.on text{fill:var(--on-acc)}
.node.off{opacity:.22}
.pulse{fill:var(--acc);filter:drop-shadow(0 0 6px var(--acc))}

/* 详情 */
.det{display:grid;grid-template-columns:1.2fr 1fr;gap:18px;padding:6px 22px 22px}
.dbox{border:1px solid var(--line);border-radius:14px;background:var(--bg2);padding:20px 22px}
.dno{font-family:var(--mono);font-size:12px;color:var(--muted);letter-spacing:1.5px}
.dno b{color:var(--acc)}
.dt{font-size:22px;font-weight:800;margin:6px 0 10px;line-height:1.35}
.pri{display:inline-block;font-family:var(--mono);font-size:11px;font-weight:700;border-radius:6px;padding:2px 8px;margin-left:6px;vertical-align:3px}
.pri.S{background:var(--acc-soft);color:var(--acc);border:1px solid var(--acc-line)}
.pri.A{background:var(--blue-soft);color:var(--blue);border:1px solid var(--blue-line)}
.goal{font-size:14.5px;color:var(--sub);border-left:3px solid var(--acc);padding:2px 0 2px 12px;margin:4px 0 14px}
.tags{display:flex;flex-wrap:wrap;gap:6px}
.tags span{font-family:var(--mono);font-size:11.5px;background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:3px 9px;color:var(--sub);opacity:0;transform:translateY(4px);animation:in .35s forwards}
@keyframes in{to{opacity:1;transform:none}}
.st{font-size:13px;font-weight:700;display:flex;align-items:center;gap:8px;margin-bottom:10px}
.st i{width:8px;height:8px;border-radius:50%}
.st.pub{color:var(--green)} .st.pub i{background:var(--green);box-shadow:0 0 8px var(--green)}
.st.soon{color:var(--muted)} .st.soon i{background:var(--line2)}
.post{display:block;border:1px solid var(--line2);border-radius:12px;padding:14px 16px;transition:.2s}
.post:hover{border-color:var(--acc);background:var(--acc-soft)}
.post small{display:block;font-family:var(--mono);font-size:11px;color:var(--muted);letter-spacing:1px}
.post b{display:block;font-size:15px;margin-top:4px}
.post .go{font-family:var(--mono);font-size:12px;color:var(--acc);margin-top:6px;display:block}
.post.empty{border-style:dashed;color:var(--muted);font-size:13.5px}
.nx{display:flex;justify-content:space-between;margin-top:14px}
.nx button{font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line2);border-radius:9px;padding:6px 12px;transition:.15s}
.nx button:hover:not(:disabled){color:var(--ink);border-color:var(--sub)}
.nx button:disabled{opacity:.3;cursor:default}

/* 开篇 */
.sh{display:flex;align-items:flex-end;justify-content:space-between;gap:14px;margin:56px 0 18px;flex-wrap:wrap}
.sh h2{font-family:var(--serif);font-size:26px;font-weight:900}
.sh h2 small{font-family:var(--mono);font-size:12px;color:var(--dim);font-weight:400;margin-left:8px;letter-spacing:1px}
.sh p{font-size:13px;color:var(--muted)}
.lead{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;border:1px solid var(--line);border-radius:18px;padding:26px 28px;background:linear-gradient(120deg,var(--acc-soft),var(--blue-soft) 45%,transparent 70%),var(--panel);position:relative;overflow:hidden}
.lead:after{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:radial-gradient(circle,var(--acc-soft),transparent 70%)}
.lead small{font-family:var(--mono);font-size:11.5px;color:var(--acc);letter-spacing:2px}
.lead h3{font-family:var(--serif);font-size:24px;font-weight:900;margin:6px 0 8px;line-height:1.4}
.lead p{font-size:14px;color:var(--sub)}
.btns{display:flex;flex-direction:column;gap:10px;position:relative;z-index:1}
.btn{font-size:13.5px;font-weight:700;border-radius:11px;padding:11px 18px;text-align:center;border:1px solid var(--line2);transition:.15s;white-space:nowrap}
.btn.p{background:var(--acc);border-color:var(--acc);color:var(--on-acc)}
.btn.p:hover{filter:brightness(1.08);box-shadow:0 0 22px var(--acc-line)}
.btn.g:hover{border-color:var(--sub)}

/* 卡片 */
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}

.disc{margin-top:60px;border-top:1px solid var(--line);padding-top:22px;font-size:12.5px;color:var(--dim);line-height:1.9;display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}

/* ---------- 手机 ---------- */
.mnav{display:none}
.hint .mb{display:none}
@media (max-width:900px){
  .app{grid-template-columns:1fr}
  .side{display:none}
  .mnav{display:flex;gap:8px;overflow-x:auto;padding:12px 16px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:6;background:var(--glass);backdrop-filter:blur(8px);scrollbar-width:none}
  .mnav::-webkit-scrollbar{display:none}
  .mnav button{flex:none;font-family:var(--mono);font-size:12px;border:1px solid var(--line2);border-radius:999px;padding:5px 11px;color:var(--sub)}
  .mnav button.on{background:var(--acc);border-color:var(--acc);color:var(--on-acc);font-weight:700}
  .mnav button.pub:not(.on){border-color:var(--green);color:var(--green)}
  .top{display:none}
  .mtop{display:flex;align-items:center;justify-content:space-between;padding:12px 16px 0;font-size:16px}
  .mtop b span{color:var(--muted);font-weight:400}
  .mnav{top:0}
  .wrap{padding:28px 16px 50px}
  h1{font-size:32px}
  .stats{grid-template-columns:repeat(3,1fr)}
  .stat{border-bottom:1px solid var(--line)}
  .stat:nth-child(3){border-right:none}
  .det{grid-template-columns:1fr;padding:6px 14px 16px}
  .lab-b{padding:16px 14px 4px}
  .lab-h{flex-wrap:wrap;padding:14px}
  .lead{grid-template-columns:1fr;padding:22px 18px}
  .grid{grid-template-columns:1fr}
  .hint .pc{display:none} .hint .mb{display:inline}
  .band{font-size:13px} .bandn{font-size:19px} .node text{font-size:19px}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
<script>
// 日夜主题与博客（Quartz）共用：localStorage "theme" + <html saved-theme>，没选过就跟随系统
(function(){
  var root=document.documentElement;
  var media=window.matchMedia?window.matchMedia('(prefers-color-scheme: light)'):null;
  function stored(){try{var v=localStorage.getItem('theme');return v==='light'||v==='dark'?v:null}catch(e){return null}}
  function resolved(){return stored()||(media&&media.matches?'light':'dark')}
  function apply(th){root.setAttribute('saved-theme',th);
    document.querySelectorAll('.theme-toggle').forEach(function(b){b.textContent=th==='light'?'☾':'☀';b.setAttribute('aria-label',th==='light'?'切换到夜晚':'切换到白天');b.title=b.getAttribute('aria-label')})}
  apply(resolved());
  if(media&&media.addEventListener)media.addEventListener('change',function(){if(!stored())apply(resolved())});
  document.addEventListener('DOMContentLoaded',function(){apply(resolved());
    document.addEventListener('click',function(e){if(!e.target.closest||!e.target.closest('.theme-toggle'))return;
      var next=root.getAttribute('saved-theme')==='light'?'dark':'light';try{localStorage.setItem('theme',next)}catch(err){}apply(next)})});
})();
</script>
