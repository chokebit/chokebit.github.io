 [0,'Python、数据与工程基础','S',0,'让你能够自己处理金融数据，而不是依赖别人已经写好的分析结果。',['Python 基础','NumPy','Pandas','Visualization'],'pub'],
 [1,'金融市场与股票数据基础','S',0,'建立“市场语言”：知道每一个数字到底代表什么。',['股票市场','股票价格','公司行为','交易'],'pub'],
 [2,'基本面投资分析','A',0,'先成为一个懂企业的投资者，而不只是“会跑策略的人”。',['财务报表','财务指标','估值','公司研究'],''],
 [3,'概率、统计与金融数学基础','S',1,'判断“这个策略赚钱”到底是有规律，还是只是随机结果。',['概率','描述统计','相关性','统计推断','回归','后续数学基础'],''],
 [4,'Quant Fundamentals','S',1,'理解量化投资是如何衡量收益和风险的。',['Return','Risk','Risk-adjusted Performance','Benchmark'],''],
 [5,'Quant Signals / Technical Signals','',1,'把“我觉得市场会涨”变成可以写成程序、可以验证的规则。',['Trend','Momentum','Mean Reversion','Oscillators','Volatility'],''],
 [6,'Factor Investing','S',2,'在一个股票池中，系统地寻找具有某种特征的股票。',['Factor 基础','Classic Factors','Cross-sectional Analysis','Factor Combination'],''],
 [7,'Backtesting','S',2,'如果过去按这个规则交易会怎样？以及为什么“回测赚钱”不等于“未来赚钱”。',['基础回测','Portfolio Backtest','Realistic Backtest','Backtest Evaluation'],''],
 [8,'防止回测欺骗 / Robust Research','S',2,'防止因为数据错误、未来数据、幸存者偏差、过拟合，误以为找到了赚钱策略。',['Bias','Overfitting','Validation','Robustness'],''],
 [9,'Portfolio / Risk / Real Trading','S',3,'我应该拿多少钱做、怎么分配、如何活下来？',['Portfolio','Portfolio Optimization','Risk Management','Trading Infrastructure'],''],
 [10,'AI Quant Engineering','A',3,'把研究流程变成 AI 可以协助执行、研究、解释、监控的系统，不是让 AI 直接“预测股票”。',['LLM 基础','Agent','AI Research','Deterministic Quant Engine'],''],
 [11,'职业化与长期能力','',3,'让能力可以被别人验证、使用、购买或雇佣。',['Quant / AI 工程能力','Quant Research Workflow','Portfolio / Career'],''],
];
// 已发布的 Stage：{编号: ['链接', '标题']}；发布时同时把上面 D 里对应项最后一位改成 'pub'
// 已发布：[链接, 标题, 笔记覆盖的 Stage]
const POST={0:['./stage-0-1.cn','0 基础用 AI 学量化：第一份笔记全公开，代码复制就能跑','0–1'],1:['./stage-0-1.cn','0 基础用 AI 学量化：第一份笔记全公开，代码复制就能跑','0–1']};
// 节点坐标：上排 0–5 左→右，下排 6–11 右→左
const XY=D.map((_,i)=>i<6?[60+i*104,95]:[580-(i-6)*104,215]);
let cur=0, filt='all';
const $=id=>document.getElementById(id);
const ns='http://www.w3.org/2000/svg';
const match=d=>filt==='all'||d[2]===filt;

// 生成节点
D.forEach((d,i)=>{
  const g=document.createElementNS(ns,'g');
  g.setAttribute('class','node '+(d[2]||'')+(d[6]==='pub'?' pub':''));
  g.setAttribute('tabindex','0'); g.setAttribute('role','button');
  g.setAttribute('aria-label','Stage '+d[0]+' '+d[1]);
  const [x,y]=XY[i];
  g.innerHTML=`<circle class="halo" cx="${x}" cy="${y}" r="34"/><circle class="c" cx="${x}" cy="${y}" r="22"/><text x="${x}" y="${y+1}">${String(d[0]).padStart(2,'0')}</text><circle class="pd" cx="${x+17}" cy="${y-17}" r="5"/>`;
  g.onclick=()=>sel(i); g.onkeydown=e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();sel(i)}};
  $('nodes').appendChild(g);
});
// 侧栏
let side='', phase=-1;
D.forEach((d,i)=>{
  if(d[3]!==phase){phase=d[3]; side+=`<div class="grp">0${phase+1} — ${PH[phase].split(' ')[1]}</div>`}
  side+=`<button class="nav${d[6]==='pub'?' pub':''}" data-i="${i}"><span class="no">${String(d[0]).padStart(2,'0')}</span>${SHORT[i]}<span class="dot"></span></button>`;
});
$('sidenav').innerHTML=side;
$('mnav').innerHTML=D.map((d,i)=>`<button class="${d[6]==='pub'?'pub':''}" data-i="${i}">${String(d[0]).padStart(2,'0')}</button>`).join('');
document.querySelectorAll('.nav,.mnav button').forEach(b=>b.onclick=()=>sel(+b.dataset.i));

function sel(i){
  cur=i; const d=D[i];
  document.querySelectorAll('.node').forEach((n,k)=>n.classList.toggle('on',k===i));
  document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('on',+n.dataset.i===i));
  document.querySelectorAll('.mnav button').forEach(n=>{n.classList.toggle('on',+n.dataset.i===i); if(+n.dataset.i===i) n.scrollIntoView({inline:'center',block:'nearest'})});
  $('dNo').textContent=String(d[0]).padStart(2,'0');
  $('dPh').textContent=PH[d[3]];
  $('dT').textContent=d[1];
  $('dP').innerHTML=d[2]?`<span class="pri ${d[2]}">${d[2]==='S'?'S 必须掌握':'A 强烈建议'}</span>`:'';
  $('dG').textContent=d[4];
  $('dTags').innerHTML=d[5].map((t,k)=>`<span style="animation-delay:${k*45}ms">${t}</span>`).join('');
  $('dS').className='st '+(d[6]==='pub'?'pub':'soon');
  $('dS').innerHTML='<i></i>'+(d[6]==='pub'?'笔记已发布':'笔记待更新');
  $('dPost').innerHTML=d[6]==='pub'
    ? `<a class="post" href="${POST[i][0]}"><small>NOTE · STAGE ${POST[i][2]||String(d[0]).padStart(2,'0')}</small><b>${POST[i][1]}</b><span class="go">打开笔记 →</span></a>`
    : `<div class="post empty">这个 Stage 的笔记还没发布。发布后会在这里出现链接。</div>`;
  $('prev').disabled=i===0; $('next').disabled=i===D.length-1;
}
function applyFilter(){
  document.querySelectorAll('.node').forEach((n,k)=>n.classList.toggle('off',!match(D[k])));
  document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('off',!match(D[+n.dataset.i])));
}
document.querySelectorAll('#seg button').forEach(b=>b.onclick=()=>{
  filt=b.dataset.f; document.querySelectorAll('#seg button').forEach(x=>x.classList.toggle('on',x===b)); applyFilter();
});
$('prev').onclick=()=>sel(Math.max(0,cur-1));
$('next').onclick=()=>sel(Math.min(D.length-1,cur+1));
document.addEventListener('keydown',e=>{
  if(e.target.closest&&e.target.closest('input,textarea'))return;
  if(e.key==='ArrowRight')sel(Math.min(D.length-1,cur+1));
  if(e.key==='ArrowLeft')sel(Math.max(0,cur-1));
});
const h=location.hash.match(/^#s(\d+)$/); sel(h?Math.min(11,+h[1]):0);
</script>
</body>
</html>
